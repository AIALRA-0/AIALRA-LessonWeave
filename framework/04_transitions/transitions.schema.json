{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "怎样按章节为已有理解和新问题安排衔接",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "status",
    "chapters_path",
    "chapter_run",
    "question_tree",
    "question_run",
    "material_tree",
    "material_run",
    "tree",
    "section_order",
    "validation"
  ],
  "properties": {
    "profile": {
      "const": "transition-plan-v1"
    },
    "status": {
      "const": "preview"
    },
    "chapters_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "chapter_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question_tree": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_tree": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tree": {
      "$ref": "#/$defs/node"
    },
    "section_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "errors"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transition_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titles",
        "covered_titles",
        "sections",
        "core_question_nodes",
        "teaching_units",
        "percentage",
        "report"
      ],
      "properties": {
        "titles": {
          "type": "integer",
          "minimum": 0
        },
        "covered_titles": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "integer",
          "minimum": 0
        },
        "core_question_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "teaching_units": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "const": 100.0
        },
        "report": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "purpose": {
      "const": "context_only"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_id",
        "kind",
        "premise",
        "question",
        "text",
        "closing_boundary",
        "review_question_ids",
        "core_question_ids",
        "previous_section_id",
        "next_section_id",
        "source_nodes",
        "units",
        "children"
      ],
      "properties": {
        "title_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "book",
            "chapter",
            "section"
          ]
        },
        "premise": {
          "type": "string",
          "pattern": "^[^\\r\\n？?]+$"
        },
        "question": {
          "type": "string",
          "pattern": "^[^\\r\\n？?]+？$"
        },
        "text": {
          "type": "string",
          "pattern": "^承上启下：[^\\r\\n？?]+？$"
        },
        "closing_boundary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "review_question_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "core_question_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "previous_section_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_section_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "next_question_id",
              "next_section_id"
            ],
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "next_question_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "next_section_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
