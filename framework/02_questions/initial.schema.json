{
  "type": "object",
  "properties": {
    "questions": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "starting_point": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "range_description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "learning_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "tree": {
          "$ref": "#/$defs/question"
        }
      },
      "required": [
        "title",
        "goal",
        "starting_point",
        "range_description",
        "learning_order",
        "tree"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "source_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "present",
        "source_nodes",
        "reason"
      ],
      "additionalProperties": false
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_nodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "extent": {
            "enum": [
              "node",
              "subtree"
            ]
          },
          "role": {
            "enum": [
              "structure",
              "reference",
              "excluded"
            ]
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_nodes",
          "extent",
          "role",
          "question_ids",
          "destination",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions",
    "metadata",
    "dispositions"
  ],
  "additionalProperties": false,
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "premise",
        "question",
        "intent",
        "source_nodes",
        "depends_on",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n？?]+？$",
          "description": "承接 premise 提出未知，以中文问号结尾，与前半段连成一行完整问句"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "premise": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "完整问句的前半段，交代具体情景或已知条件，在自然停顿处分开，与 question 直接拼接后应连贯"
        }
      }
    }
  }
}
