{
  "type": "object",
  "properties": {
    "new_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parent_question_id": {
            "type": "string",
            "minLength": 1
          },
          "after_question_id": {
            "type": "string"
          },
          "question": {
            "$ref": "#/$defs/question"
          }
        },
        "required": [
          "parent_question_id",
          "after_question_id",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "question_updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "source_additions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "source_nodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "use": {
            "enum": [
              "teach",
              "reference"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question_id",
          "source_nodes",
          "use",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_nodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extent": {
            "enum": [
              "node",
              "subtree"
            ],
            "type": "string"
          },
          "role": {
            "enum": [
              "structure",
              "reference",
              "excluded"
            ],
            "type": "string"
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_nodes",
          "extent",
          "role",
          "question_ids",
          "destination",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "learning_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "new_questions",
    "question_updates",
    "source_additions",
    "dispositions",
    "learning_order"
  ],
  "additionalProperties": false,
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "intent",
        "source_nodes",
        "depends_on",
        "children",
        "premise"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n？?]+？$",
          "description": "承接 premise 提出未知，以中文问号结尾，与前半段连成一行完整问句"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "premise": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "完整问句的前半段，交代具体情景或已知条件，在自然停顿处分开，与 question 直接拼接后应连贯"
        }
      }
    }
  }
}
