        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "explanation[0].body",
          "key": "04:authored:explanation[0].body",
          "label": "每组连续正文的示例字段",
          "description": "连续正文把解释、推导与实例沿着短骨架展开",
          "rule": "本字段展示已保存正文；旧读本仍按原结构读取",
          "type": "字符串"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "result",
          "key": "04:authored:result",
          "label": "当前问题的答案与可迁移结论",
          "description": "当前问题的答案与可迁移结论",
          "rule": "总结直接复用 answer",
          "type": "对象"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "appendix",
          "key": "04:authored:appendix",
          "label": "同次输出的练习易错点与术语",
          "description": "同次输出的练习易错点与术语",
          "rule": "按配额生成，术语直接给出完整定义",
          "type": "对象"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "appendix.terms[0]",
          "key": "04:authored:appendix.terms[0]",
          "label": "同次生成的术语示例",
          "description": "本问正文调用中生成的第一个术语及完整解释",
          "rule": "脚本按名称和词义合并展示，不新增术语生成请求",
          "type": "术语对象"
        }
      ],
      "nodes": [
        {
          "id": "N0",
          "label": "本问对应的材料范围",
          "side": "输入",
          "field_keys": [
            "04:question_node:source_nodes"
          ]
        },
        {
          "id": "N1",
          "label": "短骨架安排顺序与材料去处",
          "side": "输出",
          "field_keys": [
            "04:authored:plan.items"
          ]
        },
        {
          "id": "N2",
          "label": "核心回答与连续讲解，穿插推导和实例",
          "side": "输出",
          "field_keys": [
            "04:authored:explanation"
          ]
        },
        {
          "id": "N3",
          "label": "当前问题的答案与可迁移结论",
          "side": "输出",
          "field_keys": [
            "04:authored:result"
          ]
        },
        {
          "id": "N4",
          "label": "同次输出的练习易错点与术语",
          "side": "输出",
          "field_keys": [
            "04:authored:appendix"
          ]
        }
      ],
      "diagram": "flowchart TB\nN0[\"本问材料和必要定义\"]\nN1[\"短骨架安排顺序与材料去处\"]\nN2[\"核心回答与连续讲解，穿插推导和实例\"]\nN3[\"直接回答与迁移方法\"]\nN4[\"媒体、练习、易错点与术语\"]\nN0 --> N1\nN1 --> N2\nN2 --> N3\nN2 --> N4",
      "note": "Sol high 对每个问题只调用一次，先生成短骨架，再写连续正文、媒体、答案、练习、易错点和术语；正文保留解释、推导与实例，默认并发 144；已有共通词义复用完整三组解释"
    },
