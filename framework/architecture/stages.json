{
  "profile": "lessonweave-architecture-v1",
  "template_version": "0.15",
  "stages": [
    {
      "id": "00",
      "name": "保存原件与资源",
      "artifact": "source",
      "directory": "00_source",
      "rules_file": "00_source/acquire.py",
      "metrics": [
        "input_check",
        "acquire"
      ],
      "fields": [
        {
          "doc": "input",
          "field": "material",
          "key": "00:input:material",
          "side": "输入",
          "label": "用户上传的文件或填写的网址",
          "description": "用户上传的文件或填写的网址",
          "rule": "文件能读取，网页能取得正文与资源",
          "type": "字符串"
        },
        {
          "doc": "source",
          "field": "entry",
          "key": "00:source:entry",
          "side": "输出",
          "label": "页面打开的本地材料",
          "description": "页面打开的本地材料",
          "rule": "取得本地副本的输入数 ÷ 全部输入数 = 100%，图片可打开",
          "type": "字符串"
        }
      ],
      "nodes": [
        {
          "id": "P",
          "label": "PDF 文件",
          "side": "输入",
          "field_keys": [
            "00:input:material"
          ]
        },
        {
          "id": "W",
          "label": "网页地址",
          "side": "输入",
          "field_keys": [
            "00:input:material"
          ]
        },
        {
          "id": "R",
          "label": "仓库压缩包",
          "side": "输入",
          "field_keys": [
            "00:input:material"
          ]
        },
        {
          "id": "P1",
          "label": "本地 PDF",
          "side": "输出",
          "field_keys": [
            "00:source:entry"
          ]
        },
        {
          "id": "W1",
          "label": "离线网页与资源",
          "side": "输出",
          "field_keys": [
            "00:source:entry"
          ]
        },
        {
          "id": "R1",
          "label": "解压后的仓库文件",
          "side": "输出",
          "field_keys": [
            "00:source:entry"
          ]
        }
      ],
      "diagram": "flowchart TB\nP[\"PDF 文件\"]\nW[\"网页地址\"]\nR[\"仓库压缩包\"]\nP1[\"本地 PDF\"]\nW1[\"离线网页与资源\"]\nR1[\"解压后的仓库文件\"]\nP -->|\"保存 · 一对一\"| P1\nW -->|\"抓取并保存 · 一对多\"| W1\nR -->|\"解压并保存 · 一对多\"| R1",
      "note": "网页由 Browsertrix 保存为 WACZ，再从离线回放读取 DOM、图片与定位；PDF 保留原始字节，仓库保留文件与路径"
    },
    {
      "id": "01.1",
      "name": "解析材料树",
      "artifact": "material",
      "directory": "01_tree",
      "rules_file": "01_tree/content_checks.py",
      "metrics": [
        "parse"
      ],
      "fields": [
        {
          "doc": "source",
          "field": "entry",
          "key": "01.1:source:entry",
          "side": "输入",
          "label": "上一步保存的材料入口",
          "description": "上一步保存的材料入口",
          "rule": "读取 00 保存的同一份材料",
          "type": "字符串"
        },
        {
          "doc": "material_group",
          "field": "children",
          "key": "01.1:material_group:children",
          "side": "输出",
          "label": "材料节点下面的子节点",
          "description": "材料节点下面的子节点",
          "rule": "层级无环，每个子节点只有一个父节点",
          "type": "节点数组"
        },
        {
          "doc": "material_node",
          "field": "content",
          "key": "01.1:material_node:content",
          "side": "输出",
          "label": "材料树中直接展示的原文、图表或代码",
          "description": "材料树中直接展示的原文、图表或代码",
          "rule": "有树节点保留的原始内容项 ÷ 原始内容项总数 = 100%，逐字核对文字与对象存在",
          "type": "文字或对象"
        },
        {
          "doc": "material_node",
          "field": "source",
          "key": "01.1:material_node:source",
          "side": "输出",
          "label": "点击材料时跳到的原始位置",
          "description": "点击材料时跳到的原始位置",
          "rule": "位置属于当前材料，并落在实际范围内",
          "type": "位置对象"
        }
      ],
      "nodes": [
        {
          "id": "P",
          "label": "PDF 原页",
          "side": "输入",
          "field_keys": [
            "01.1:source:entry"
          ]
        },
        {
          "id": "W",
          "label": "本地网页",
          "side": "输入",
          "field_keys": [
            "01.1:source:entry"
          ]
        },
        {
          "id": "R",
          "label": "仓库源码",
          "side": "输入",
          "field_keys": [
            "01.1:source:entry"
          ]
        },
        {
          "id": "M",
          "label": "材料树层级",
          "side": "输出",
          "field_keys": [
            "01.1:material_group:children"
          ]
        },
        {
          "id": "C",
          "label": "原文、图表或代码",
          "side": "输出",
          "field_keys": [
            "01.1:material_node:content"
          ]
        },
        {
          "id": "L",
          "label": "原始位置",
          "side": "输出",
          "field_keys": [
            "01.1:material_node:source"
          ]
        }
      ],
      "diagram": "flowchart TB\nP[\"PDF 原页\"]\nW[\"本地网页\"]\nR[\"仓库源码\"]\nM[\"材料树层级\"]\nC[\"原文、图表或代码\"]\nL[\"原始位置\"]\nP -->|\"Docling + PyMuPDF\"| M\nW -->|\"BeautifulSoup 读取 DOM\"| M\nR -->|\"架构解析 + Tree-sitter\"| M\nM -->|\"包含内容\"| C\nC -->|\"保留来源位置\"| L",
      "note": "网页解析 DOM，PDF 使用 Docling 与原页坐标，代码按语言路由语法解析；非主体内容只标记用途，原件继续保留"
    },
    {
      "id": "02",
      "name": "规划第 0 章与正文问题",
      "artifact": "questions",
      "directory": "02_questions",
      "rules_file": "02_questions/source_disposition.py",
      "metrics": [
        "questions"
      ],
      "fields": [
        {
          "side": "输入",
          "doc": "material_node",
          "field": "content",
          "key": "02:material_node:content",
          "label": "材料节点的真实内容",
          "description": "材料节点的真实内容",
          "rule": "材料树直接进入问题规划",
          "type": "对象"
        },
        {
          "side": "输出",
          "doc": "question_node",
          "field": "premise",
          "key": "02:question_node:premise",
          "label": "直接引出问题的前提",
          "description": "直接引出问题的前提",
          "rule": "前提与问题存在直接逻辑关系",
          "type": "字符串"
        },
        {
          "side": "输出",
          "doc": "question_node",
          "field": "question",
          "key": "02:question_node:question",
          "label": "学习者需要解决的问题",
          "description": "学习者需要解决的问题",
          "rule": "同一行输出并以问号结尾",
          "type": "字符串"
        },
        {
          "side": "输出",
          "doc": "question_node",
          "field": "source_nodes",
          "key": "02:question_node:source_nodes",
          "label": "问题负责的材料节点",
          "description": "问题负责的材料节点",
          "rule": "具体问题负责讲解来源，容器与导航登记结构用途，同内容表示关联已有去处，两项覆盖率均由脚本计算",
          "type": "ID 列表"
        },
        {
          "side": "输出",
          "doc": "questions",
          "field": "metadata",
          "key": "02:questions:metadata",
          "label": "原件是否有可用元数据",
          "description": "原件是否有可用元数据",
          "rule": "有用元数据进入同一问题树的 q.0，没有时不创建",
          "type": "对象"
        },
        {
          "side": "输出",
          "doc": "questions",
          "field": "dispositions",
          "key": "02:questions:dispositions",
          "label": "材料的结构、查阅和排除用途",
          "description": "材料的结构、查阅和排除用途",
          "rule": "未知用途继续列为缺项，广告保留原件与排除原因",
          "type": "数组"
        }
      ],
      "nodes": [
        {
          "id": "N0",
          "label": "材料节点的真实内容",
          "side": "输入",
          "field_keys": [
            "02:material_node:content"
          ]
        },
        {
          "id": "N1",
          "label": "直接引出问题的前提",
          "side": "输出",
          "field_keys": [
            "02:question_node:premise"
          ]
        },
        {
          "id": "N2",
          "label": "学习者需要解决的问题",
          "side": "输出",
          "field_keys": [
            "02:question_node:question"
          ]
        },
        {
          "id": "N3",
          "label": "问题负责的材料节点",
          "side": "输出",
          "field_keys": [
            "02:question_node:source_nodes"
          ]
        },
        {
          "id": "N4",
          "label": "第 0 章与正文的问题职责",
          "side": "输出",
          "field_keys": [
            "02:questions:metadata",
            "02:question_node:source_nodes"
          ]
        },
        {
          "id": "N5",
          "label": "结构、查阅和排除用途",
          "side": "输出",
          "field_keys": [
            "02:questions:dispositions"
          ]
        }
      ],
      "diagram": "flowchart TB\nN0[\"完整材料树\"]\nN1[\"直接引出问题的前提\"]\nN2[\"学习者需要解决的问题\"]\nN3[\"具体问题负责的来源\"]\nN4[\"第 0 章与正文的问题职责\"]\nN5[\"结构、查阅和排除用途\"]\nN0 --> N1\nN0 --> N2\nN1 --> N4\nN2 --> N4\nN4 --> N3\nN0 --> N5",
      "note": "Sol high 首轮同时规划第 0 章与正文，脚本核对每个节点去向，有缺项才发送差集补齐"
    },
    {
      "id": "03",
      "name": "编排章节",
      "artifact": "chapters",
      "directory": "03_chapters",
      "rules_file": "03_chapters/build_chapters.py",
      "metrics": [
        "chapters"
      ],
      "fields": [
        {
          "doc": "question_node",
          "field": "question",
          "key": "03:question_node:question",
          "side": "输入",
          "label": "上一阶段保存的完整问题",
          "description": "上一阶段保存的完整问题",
          "rule": "已分配问题 ÷ 全部问题 = 100%，每个问题恰好分配一次",
          "type": "字符串 × 2",
          "combine": [
            "premise",
            "question"
          ]
        },
        {
          "doc": "chapter_node",
          "field": "kind",
          "key": "03:chapter_node:kind",
          "side": "输出",
          "label": "标题层级",
          "description": "标题属于书、章还是节，数组位置决定阅读顺序",
          "rule": "第 0 章排在正文之前，章节顺序满足问题依赖",
          "type": "枚举"
        },
        {
          "doc": "chapter_node",
          "field": "title",
          "key": "03:chapter_node:title",
          "side": "输出",
          "label": "目录与正文保存的完整章标题",
          "description": "目录与正文保存的完整章标题",
          "rule": "第 0 章使用 0. 与 0.1.，正文使用 1. 与 1.1.，标题由前提加问题组成",
          "type": "字符串"
        }
      ],
      "nodes": [
        {
          "id": "Q",
          "label": "完整问题",
          "side": "输入",
          "field_keys": [
            "03:question_node:question"
          ]
        },
        {
          "id": "O",
          "label": "章节层级与阅读顺序",
          "side": "输出",
          "field_keys": [
            "03:chapter_node:kind"
          ]
        },
        {
          "id": "C",
          "label": "问题式章标题",
          "side": "输出",
          "field_keys": [
            "03:chapter_node:title"
          ]
        }
      ],
      "diagram": "flowchart TB\nQ[\"完整问题\"]\nO[\"章节层级与阅读顺序\"]\nC[\"问题式章标题\"]\nQ -->|\"按前置理解关系分配 · 多对一\"| O\nO -->|\"按序生成标题\"| C",
      "note": "Sol high 读取带编号的问题树，只输出标题和问题归属，脚本继承来源、依赖及实际排列"
    },
    {
      "id": "04",
      "name": "生成正文、媒体、练习与术语",
      "artifact": "authored",
      "directory": "05_writing",
      "rules_file": "05_writing/lean_contract.py",
      "metrics": [
        "writing"
      ],
      "fields": [
        {
          "side": "输入",
          "doc": "question_node",
          "field": "source_nodes",
          "key": "04:question_node:source_nodes",
          "label": "本问对应的材料范围",
          "description": "本问对应的材料范围",
          "rule": "只读取当前问题需要的实际材料",
          "type": "ID 列表"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "plan.items",
          "key": "04:authored:plan.items",
          "label": "问题内部的多条讲解规划",
          "description": "问题内部的多条讲解规划",
          "rule": "在 逐问调用内部输出并保留材料对应",
          "type": "对象列表"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "explanation",
          "key": "04:authored:explanation",
          "label": "围绕规划展开的正文与媒体",
          "description": "围绕规划展开的正文与媒体",
          "rule": "每组保留实际材料与规划 ID",
          "type": "对象列表"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "result",
          "key": "04:authored:result",
          "label": "当前问题的答案与可迁移结论",
          "description": "当前问题的答案与可迁移结论",
          "rule": "总结直接复用 answer",
          "type": "对象"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "appendix",
          "key": "04:authored:appendix",
          "label": "同次输出的练习易错点与术语",
          "description": "同次输出的练习易错点与术语",
          "rule": "按配额生成，术语直接给出完整定义",
          "type": "对象"
        }
      ],
      "nodes": [
        {
          "id": "N0",
          "label": "本问对应的材料范围",
          "side": "输入",
          "field_keys": [
            "04:question_node:source_nodes"
          ]
        },
        {
          "id": "N1",
          "label": "问题内部的多条讲解规划",
          "side": "输出",
          "field_keys": [
            "04:authored:plan.items"
          ]
        },
        {
          "id": "N2",
          "label": "围绕规划展开的正文与媒体",
          "side": "输出",
          "field_keys": [
            "04:authored:explanation"
          ]
        },
        {
          "id": "N3",
          "label": "当前问题的答案与可迁移结论",
          "side": "输出",
          "field_keys": [
            "04:authored:result"
          ]
        },
        {
          "id": "N4",
          "label": "同次输出的练习易错点与术语",
          "side": "输出",
          "field_keys": [
            "04:authored:appendix"
          ]
        }
      ],
      "diagram": "flowchart TB\nN0[\"本问对应的材料范围\"]\nN1[\"问题内部的多条讲解规划\"]\nN2[\"围绕规划展开的正文与媒体\"]\nN3[\"当前问题的答案与可迁移结论\"]\nN4[\"同次输出的练习易错点与术语\"]\nN0 --> N1\nN0 --> N2\nN0 --> N3\nN0 --> N4",
      "note": "Sol high 每问同次输出多条讲解规划、问题、多组讲解、媒体、答案、易错点、练习及术语；默认并发 144，已有词义复用完整三段解释"
    },
    {
      "id": "05",
      "name": "并行生成中文译文",
      "artifact": "sentence",
      "directory": "05_writing",
      "rules_file": "05_writing/lean_contract.py",
      "metrics": [
        "translation"
      ],
      "fields": [
        {
          "side": "输入",
          "doc": "sentence",
          "field": "id",
