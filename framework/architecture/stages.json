      "diagram": "flowchart TB\nN0[\"原句的稳定位置编号\"]\nN1[\"真实原句\"]\nN2[\"中文显示文本\"]\nN3[\"英文显示文本\"]\nN0 --> N2\nN0 --> N3\nN1 --> N2\nN1 --> N3",
      "note": "Flash 非推理只翻译去重后的自然语言，保留源码、公式、URL；每批约 24000 UTF-8 字节，并发 12，中文译英文按需生成"
    },
    {
      "id": "06",
      "name": "根据实际答案生成两段承接",
      "artifact": "bridge",
      "directory": "05_writing",
      "rules_file": "05_writing/lean_contract.py",
      "metrics": [
        "transitions"
      ],
      "fields": [
        {
          "side": "输入",
          "doc": "authored",
          "field": "result",
          "key": "06:authored:result",
          "label": "当前问题实际讲清的结果",
          "description": "当前问题实际讲清的结果",
          "rule": "不重新传入整篇正文与原材料",
          "type": "对象"
        },
        {
          "side": "输出",
          "doc": "bridge",
          "field": "carryover",
          "key": "06:bridge:carryover",
          "label": "第一段承上",
          "description": "第一段承上",
          "rule": "依据前节实际结果，首节从材料情境起笔",
          "type": "字符串"
        },
        {
          "side": "输出",
          "doc": "bridge",
          "field": "premise",
          "key": "06:bridge:premise",
          "label": "启下的直接条件",
          "description": "启下的直接条件",
          "rule": "与当前问题直接相关",
          "type": "字符串"
