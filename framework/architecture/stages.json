    {
      "id": "04",
      "name": "生成正文、媒体、练习与术语",
      "artifact": "authored",
      "directory": "05_writing",
      "rules_file": "05_writing/lean_contract.py",
      "metrics": [
        "writing"
      ],
      "fields": [
        {
          "side": "输入",
          "doc": "question_node",
          "field": "source_nodes",
          "key": "04:question_node:source_nodes",
          "label": "本问对应的材料范围",
          "description": "本问对应的材料范围",
          "rule": "只读取当前问题需要的实际材料",
          "type": "ID 列表"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "plan.items",
          "key": "04:authored:plan.items",
          "label": "短骨架怎样安排每一步",
          "description": "先安排理解顺序、核心回答、展开步骤、实际来源与下一组的承接",
          "rule": "本问全部分配材料都要有讲解去处，来源对应由脚本按实际引用计算",
          "type": "对象列表"
        },
        {
          "side": "输出",
          "doc": "authored",
          "field": "explanation",
          "key": "04:authored:explanation",
          "label": "正文怎样沿骨架连续展开",
