          "key": "05:sentence:english",
          "label": "英文显示文本",
          "description": "英文显示文本",
          "rule": "英文原句保持原样",
          "type": "字符串"
        }
      ],
      "nodes": [
        {
          "id": "N0",
          "label": "原句的稳定位置编号",
          "side": "输入",
          "field_keys": [
            "05:sentence:id"
          ]
        },
        {
          "id": "N1",
          "label": "真实原句",
          "side": "输入",
          "field_keys": [
            "05:sentence:original"
          ]
