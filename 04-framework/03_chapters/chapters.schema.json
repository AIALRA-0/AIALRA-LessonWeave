{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "怎样让全部问题各归属一个标题，并按前置理解组织成书",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "question_tree",
    "question_run",
    "material_tree",
    "material_run",
    "tree",
    "learning_order",
    "validation"
  ],
  "properties": {
    "profile": {
      "const": "chapter-outline-v1"
    },
    "question_tree": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_tree": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tree": {
      "$ref": "#/$defs/title"
    },
    "learning_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "errors"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chapter_run": {
      "type": "string",
      "pattern": "^revision-[0-9]{4,}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_nodes",
        "assigned_questions",
        "assignments",
        "material_nodes",
        "covered_material_nodes",
        "dependency_edges",
        "order_conflicts",
        "percentage",
        "assignment_percentage",
        "material_percentage",
        "unassigned_questions",
        "duplicated_questions",
        "report"
      ],
      "properties": {
        "question_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "assigned_questions": {
          "type": "integer",
          "minimum": 0
        },
        "assignments": {
          "type": "integer",
          "minimum": 0
        },
        "material_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "covered_material_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "dependency_edges": {
          "type": "integer",
          "minimum": 0
        },
        "order_conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0
        },
        "assignment_percentage": {
          "type": "number",
          "minimum": 0
        },
        "material_percentage": {
          "type": "number",
          "minimum": 0
        },
        "unassigned_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "duplicated_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "report": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  },
  "$defs": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "premise",
        "question",
        "title",
        "focus",
        "question_ids",
        "source_nodes",
        "requires",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "book",
            "chapter",
            "section"
          ]
        },
        "premise": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n？?]+$"
        },
        "question": {
          "type": "string",
          "pattern": "^[^\\r\\n？?]+？$"
        },
        "title": {
          "type": "string",
          "pattern": "^[^\\r\\n？?]+？$"
        },
        "focus": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "source_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/title"
          }
        }
      }
    }
  }
}
