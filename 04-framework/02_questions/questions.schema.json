{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "每个学习问题怎样从明确情景引出问题，并覆盖全部材料",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "scope",
    "title",
    "goal",
    "starting_point",
    "range_description",
    "material_tree",
    "material_run",
    "source_roots",
    "context_nodes",
    "learning_order",
    "tree",
    "validation"
  ],
  "properties": {
    "profile": {
      "const": "learning-questions-v1"
    },
    "scope": {
      "enum": [
        "selected_branch",
        "full_material"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "starting_point": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "range_description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_tree": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "context_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "learning_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "tree": {
      "$ref": "#/$defs/question"
    },
    "validation": {
      "type": "object",
      "required": [
        "passed",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "question_run": {
      "type": "string",
      "pattern": "^revision-[0-9]{4,}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "covered",
        "percentage",
        "links",
        "mapping_percentage",
        "leaf_questions",
        "unmapped",
        "by_type",
        "report"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "leaf_questions": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mapping_percentage": {
          "type": "number",
          "minimum": 0
        },
        "unmapped": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "total",
              "covered"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "covered": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "report": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "premise",
        "question",
        "intent",
        "source_nodes",
        "depends_on",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n？?]+？$",
          "description": "承接 premise 提出未知，以中文问号结尾，与前半段连成一行完整问句"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "premise": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "完整问句的前半段，交代具体情景或已知条件，在自然停顿处分开，与 question 直接拼接后应连贯"
        }
      }
    }
  }
}
