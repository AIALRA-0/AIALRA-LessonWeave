{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "怎样检查完整教材的目录、问题回答与材料映射",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "id",
    "title",
    "introduction",
    "transitions_path",
    "transition_run",
    "writing_run",
    "goals",
    "chapters",
    "coverage",
    "validation"
  ],
  "properties": {
    "profile": {
      "const": "learning-book-v1"
    },
    "id": {
      "const": "book"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "introduction": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "transitions_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "transition_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "writing_run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "text",
          "answer",
          "source_nodes"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_nodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "title",
          "goals",
          "sections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "number": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_id",
                "text",
                "answer",
                "source_nodes"
              ],
              "properties": {
                "question_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "answer": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_nodes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "number",
                "title",
                "path"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "number": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "question_nodes",
        "answered_questions",
        "teaching_units",
        "material_nodes",
        "covered_material_nodes",
        "quiz",
        "unique_terms",
        "question_percentage",
        "material_mapping_percentage"
      ],
      "properties": {
        "sections": {
          "type": "integer",
          "minimum": 0
        },
        "question_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "answered_questions": {
          "type": "integer",
          "minimum": 0
        },
        "teaching_units": {
          "type": "integer",
          "minimum": 0
        },
        "material_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "covered_material_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "quiz": {
          "type": "integer",
          "minimum": 0
        },
        "unique_terms": {
          "type": "integer",
          "minimum": 0
        },
        "question_percentage": {
          "const": 100.0
        },
        "material_mapping_percentage": {
          "const": 100.0
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "passed",
        "errors"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "writing_rules_version": {
      "type": "integer",
      "const": 2
    },
    "grounding_report_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "dependentRequired": {
    "writing_rules_version": [
      "grounding_report_path"
    ],
    "grounding_report_path": [
      "writing_rules_version"
    ]
  }
}
