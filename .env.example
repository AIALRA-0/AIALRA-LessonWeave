LESSONWEAVE_DATA=/var/lib/lessonweave
LESSONWEAVE_BACKEND=codex
LESSONWEAVE_MODEL=gpt-6.1-sol
LESSONWEAVE_EFFORT=high
LESSONWEAVE_TRANSLATION_MODEL=deepseek-flash
LESSONWEAVE_TRANSLATION_EFFORT=off
LESSONWEAVE_CALLS=144
LESSONWEAVE_WRITING_CALLS=144
LESSONWEAVE_TRANSLATION_CALLS=12
LESSONWEAVE_TRANSLATION_BYTES=24000
LESSONWEAVE_BRIDGE_CALLS=7
LESSONWEAVE_BRIDGE_BATCH_SECTIONS=16
LESSONWEAVE_REPAIR_CALLS=3
LESSONWEAVE_TIMEOUT=1800
LESSONWEAVE_PDF_ENGINE=docling
LESSONWEAVE_AUTH_REQUIRED=1
LESSONWEAVE_OWNER=your-login-name
# ReadWeave 与 Trilium 必须指向同一正式库，令牌只由服务端读取
# 独立部署器会先写入回环网址并保持桥接关闭；原生首次设置后再用 --configure-token 写入令牌
# LESSONWEAVE_READWEAVE_BRIDGE=0
# LESSONWEAVE_READWEAVE_URL=http://127.0.0.1:18961
# LESSONWEAVE_READWEAVE_TOKEN=
# LESSONWEAVE_TRILIUM_URL=http://127.0.0.1:18961
# LESSONWEAVE_TRILIUM_TOKEN=
# 根目录和回收站会在提供有效 ETAPI token 后幂等创建；已有自定义笔记 ID 可以保留
# LESSONWEAVE_TRILIUM_ROOT=
# LESSONWEAVE_TRILIUM_TRASH=
# 这里填写同一 ReadWeave 实例的浏览器入口
# LESSONWEAVE_TRILIUM_PUBLIC_URL=https://notes.example.com

# 留空时在本机 Docker 获取网页，填写 SSH 主机名时在该主机获取并取回归档
LESSONWEAVE_ARCHIVE_SSH=
LESSONWEAVE_ARCHIVE_WORKDIR=/tmp/lessonweave-archives
