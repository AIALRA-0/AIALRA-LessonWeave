LESSONWEAVE_DATA=/var/lib/lessonweave
LESSONWEAVE_BACKEND=codex
LESSONWEAVE_MODEL=gpt-6.1-sol
LESSONWEAVE_EFFORT=high
LESSONWEAVE_CALLS=3
LESSONWEAVE_TIMEOUT=1800
LESSONWEAVE_PDF_ENGINE=pymupdf
LESSONWEAVE_AUTH_REQUIRED=1
LESSONWEAVE_OWNER=your-login-name
# 配置后，新项目会写入此 Trilium 实例的笔记与附件，令牌只由服务端读取
# LESSONWEAVE_TRILIUM_URL=http://127.0.0.1:8080
# LESSONWEAVE_TRILIUM_TOKEN=
# LESSONWEAVE_TRILIUM_ROOT=
# LESSONWEAVE_TRILIUM_TRASH=
# 这里填写同一 Trilium 实例的浏览器入口，导入演示库的笔记 ID 只用于该演示库
# LESSONWEAVE_TRILIUM_PUBLIC_URL=https://notes.example.com
